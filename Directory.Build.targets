<Project>
  <!-- Fork: AnyCPU only. Imported after each csproj, so this overrides upstream's "AnyCPU;x64" without editing project files. -->
  <PropertyGroup>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <!-- Fork: the throughput benchmark drives a Session directly, which needs internal constructors. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'QuickFix'">
    <InternalsVisibleTo Include="Throughput" />
  </ItemGroup>
</Project>
